# Skopiuj do backend/.env i uzupełnij wartościami (nie commituj .env)

# Baza CRM — osobna baza, nie daily_dish
DATABASE_URL=postgresql://postgres:haslo@localhost:5432/crm_console

# Min. 32 znaki: openssl rand -base64 48
JWT_SECRET=
# Domyślnie 12h
JWT_EXPIRES_IN=12h

PORT=3002
# Origin frontendu CRM (konsola) — CORS
FRONTEND_URL=http://localhost:3000
# Adres aplikacji głównej (bistromapa.app) — z niego budujemy link aktywacyjny
# w mailu: {BISTRO_APP_URL}/auth/activate/<token>
BISTRO_APP_URL=http://localhost:3001

# Konto administratora — potrzebne tylko dla `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wysyłka emaili przez Resend (bez tego wysyłka zwraca błąd)
# Klucz pobierz z https://resend.com  — wyłącznie backend, nigdy frontend
RESEND_API=
# Nadawca widoczny w mailach (musi być zweryfikowany w Resend)
EMAIL_FROM=BistroMapa <kontakt@bistromapa.app>

# Źródło leadów dla kampanii: mock | google
LEAD_SOURCE_PROVIDER=mock
# Klucz Places API — wyłącznie backend
GOOGLE_MAPS_API_KEY=

# Integracja z głównym backendem BistroMapy (bistromapa.api)
# BISTRO_API_TOKEN musi być ten sam po obu stronach — chroni endpointy CRM w bistromapa.api
BISTRO_API_URL=http://localhost:3000/api
BISTRO_API_TOKEN=
