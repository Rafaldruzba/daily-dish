# Skopiuj do backend/.env i uzupełnij wartościami (nie commituj .env)

# Baza CRM — osobna baza, nie daily_dish
DATABASE_URL=postgresql://postgres:haslo@localhost:5432/crm_console

# Min. 32 znaki: openssl rand -base64 48
JWT_SECRET=
# Domyślnie 12h
JWT_EXPIRES_IN=12h

PORT=3002
# Origin frontendu CRM (CORS + ciasteczko sesji)
FRONTEND_URL=http://localhost:3000

# Konto administratora — potrzebne tylko dla `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wysyłka emaili (bez tego wysyłka zwraca błąd)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Źródło leadów dla kampanii: mock | google
LEAD_SOURCE_PROVIDER=mock
# Klucz Places API — wyłącznie backend
GOOGLE_MAPS_API_KEY=

# Integracja z głównym backendem BistroMapy (TODO: endpoint onboardingu jeszcze nie istnieje)
BISTRO_API_URL=
BISTRO_API_TOKEN=
