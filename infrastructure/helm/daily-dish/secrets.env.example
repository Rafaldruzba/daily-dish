# Local development values only. Copy to secrets.env and replace external API tokens.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=daily_dish
CRM_POSTGRES_USER=postgres
CRM_POSTGRES_PASSWORD=postgres
CRM_POSTGRES_DB=crm_console
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/daily_dish?schema=public
CRM_DATABASE_URL=postgresql://postgres:postgres@postgres-crm:5432/crm_console
API_JWT_SECRET=local-only-api-secret-change-this-to-a-random-value-longer-than-32-characters
CRM_JWT_SECRET=local-only-crm-secret-change-this-to-a-random-value-longer-than-32-characters
BISTRO_API_TOKEN=local-only-change-this-shared-token
API_ADMIN_EMAIL=app@localhost
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-this-local-password-123
APIFY_TOKEN=replace-with-your-apify-token
API_METRICS_TOKEN=
