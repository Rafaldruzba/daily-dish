# Grafana for Railway
FROM grafana/grafana:11.2.0

ENV GF_USERS_ALLOW_SIGN_UP=false
ENV GF_SERVER_ROOT_URL=/
ENV GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/app-overview.json
ENV GF_SERVER_PROTOCOL=http
ENV GF_PATHS_DATA=/tmp/grafana
ENV GF_PATHS_PLUGINS=/tmp/grafana/plugins
ENV GF_PATHS_PROVISIONING=/etc/grafana/provisioning

RUN mkdir -p /tmp/grafana/plugins /etc/grafana/provisioning /var/lib/grafana/dashboards

USER root

# Grafana runs as root in Railway (512 permission safe); data in /tmp/grafana writable
EXPOSE 3000

# Copy provisioning/dashboards BEFORE chown so 472 owns them
COPY --chown=472:472 grafana/provisioning/ /etc/grafana/provisioning/
COPY --chown=472:472 grafana/dashboards/ /var/lib/grafana/dashboards/

CMD ["/run.sh"]
