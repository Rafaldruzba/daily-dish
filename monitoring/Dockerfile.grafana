# Grafana for Railway
FROM grafana/grafana:11.2.0

# Copy provisioning (datasources, dashboards loading)
COPY grafana/provisioning/ /etc/grafana/provisioning/

# Copy dashboards (loaded by provisioning or manually)
COPY grafana/dashboards/ /var/lib/grafana/dashboards/

ENV GF_SECURITY_ADMIN_USER=admin
ENV GF_SECURITY_ADMIN_PASSWORD=admin
ENV GF_USERS_ALLOW_SIGN_UP=false
ENV GF_SERVER_ROOT_URL=/
ENV GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/app-overview.json
ENV GF_SERVER_PROTOCOL=http

EXPOSE 3000

# Grafana runs as default entrypoint (already configured)
