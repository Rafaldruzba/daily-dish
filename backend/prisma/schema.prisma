generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                 String      @id @default(uuid())
  name               String
  slug               String      @unique
  phone              String?
  address            String?
  city               String
  facebookUrl        String?
  isActive           Boolean     @default(true)
  rating             Float?      @default(0.0)
  description        String?
  generalMenu        String?

  latitude           Float?
  longitude          Float?
  googlePlaceId      String?
  userRatingsTotal   Int?        @default(0)
  
  status             String      @default("PENDING") // PENDING, APPROVED, REJECTED
  views              Int         @default(0)         // Licznik odwiedzin profilu/dań

  userId             String?

  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  dishes             DailyDish[]
  favorites          FavoriteRestaurant[]
  standardOffers     StandardOffer[]
  menuItems          MenuItem[]
  subscriptions      Subscription[]
  payments           Payment[]
  
  removalRequestedAt DateTime?
  staticOfferTitle   String?
  staticOfferDesc    String?
  staticOfferPrice   Float?
  staticOfferImg     String?
  
  reviews            Review[]
  declarations       OwnershipDeclaration[]
  reports            RestaurantReport[]

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Subscription {
  id               String     @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  type             String     // e.g., 'BASE', 'PROMOTION', 'STATIC_MENU'
  status           String     // e.g., 'ACTIVE', 'EXPIRED', 'CANCELLED'
  
  startsAt         DateTime
  endsAt           DateTime

  stripeCustomerId     String?    // This field should probably be on the User or Restaurant model
  stripeSubscriptionId String?    @unique

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([restaurantId])
}

model Payment {
  id                String      @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount            Decimal     @db.Decimal(10, 2)
  currency          String      @default("PLN")
  status            String      // e.g., SUCCEEDED, PENDING, FAILED
  provider          String      // e.g., STRIPE, PAYU (or MOCK for simulation)
  providerPaymentId String?     @unique
  createdAt         DateTime    @default(now())
}

model StandardOffer {
  id           String    @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  price        Float?
  imageUrl     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MenuItem {
  id           String    @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float
  category     String
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
}

model DailyDish {
  id           String      @id @default(uuid())
  restaurantId String

  name         String
  description  String?
  price        Decimal?    @db.Decimal(10, 2)
  imageUrl     String?
  sourceUrl    String?
  sourcePostId String?

  isPromoted   Boolean     @default(false)

  date         DateTime
  publishedAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date], name: "restaurantId_date")
  @@index([date])
  @@index([restaurantId])
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  name                String?
  role                String   @default("USER") // "USER", "OWNER" or "ADMIN"
  city                String?
  commentBanExpiresAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  favorites    FavoriteRestaurant[]
  restaurants  Restaurant[]
  reviews      Review[]
  declarations OwnershipDeclaration[]
  reports      RestaurantReport[]
  commentReports CommentReport[]
}

model FavoriteRestaurant {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

model SystemStats {
  id    String @id @default("global")
  views Int    @default(0)
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // INFO, WARN, ERROR
  message   String
  context   String?  // Dodatkowe dane w formacie tekstowym/JSON
  createdAt DateTime @default(now())
}

model Review {
  id           String          @id @default(uuid())
  rating       Int             // Skala 1 do 5
  comment      String          // Wymagany tekst komentarza
  userId       String
  restaurantId String
  isHidden     Boolean         @default(false) // Dla celów automatycznego ukrywania przy zgłoszeniach
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reports      CommentReport[]

  @@unique([userId, restaurantId]) // Blokada wielu opinii od jednej osoby
}

model OwnershipDeclaration {
  id            String     @id @default(uuid())
  userId        String
  restaurantId  String?
  nip           String?    // Opcjonalny NIP firmy
  ownerPhone    String     // Telefon kontaktowy właściciela
  representsSelf Boolean    @default(true) // Oświadczenie o uprawnieniu
  acceptedTerms Boolean    @default(true) // Akceptacja regulaminu
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
}

model RestaurantReport {
  id           String     @id @default(uuid())
  restaurantId String
  userId       String?
  reason       String     // INCORRECT_DATA, SCAM, IMPERSONATION, OTHER
  details      String?    // Szczegóły zgłoszenia
  resolved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CommentReport {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String?
  reason    String   // VULGAR, UNTRUTHFUL, TOS_VIOLATION, RIGHTS_VIOLATION
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

