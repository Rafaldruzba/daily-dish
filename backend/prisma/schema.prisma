generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                 String      @id @default(uuid())
  name               String
  slug               String      @unique
  phone              String?
  address            String?
  city               String
  facebookUrl        String?
  isActive           Boolean     @default(true)
  rating             Float?      @default(0.0)
  description        String?
  generalMenu        String?
  
  status             String      @default("PENDING") // PENDING, APPROVED, REJECTED
  views              Int         @default(0)         // Licznik odwiedzin profilu/dań
  
  subscriptionPlan   String      @default("FREE_TRIAL") // FREE_TRIAL, ACTIVE, EXPIRED
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  userId             String?

  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  dishes             DailyDish[]
  favorites          FavoriteRestaurant[]

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model DailyDish {
  id           String      @id @default(uuid())
  restaurantId String

  name         String
  description  String?
  price        Decimal?    @db.Decimal(10, 2)
  imageUrl     String?
  sourceUrl    String?
  sourcePostId String?

  date         DateTime
  publishedAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date], name: "restaurantId_date")
  @@index([date])
  @@index([restaurantId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // "USER", "OWNER" or "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites   FavoriteRestaurant[]
  restaurants Restaurant[]
}

model FavoriteRestaurant {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

model SystemStats {
  id    String @id @default("global")
  views Int    @default(0)
}
