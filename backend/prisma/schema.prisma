generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                 String      @id @default(uuid())
  name               String
  slug               String      @unique
  phone              String?
  address            String?
  city               String
  facebookUrl        String?
  isActive           Boolean     @default(true)
  rating             Float?      @default(0.0)
  description        String?
  generalMenu        String?

  latitude           Float?
  longitude          Float?
  
  status             String      @default("PENDING") // PENDING, APPROVED, REJECTED
  views              Int         @default(0)         // Licznik odwiedzin profilu/dań

  userId             String?

  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  dishes             DailyDish[]
  favorites          FavoriteRestaurant[]
  standardOffers     StandardOffer[]
  menuItems          MenuItem[]
  subscriptions      Subscription[]
  payments           Payment[]

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Subscription {
  id               String     @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  type             String     // e.g., 'BASE', 'PROMOTION', 'STATIC_MENU'
  status           String     // e.g., 'ACTIVE', 'EXPIRED', 'CANCELLED'
  
  startsAt         DateTime
  endsAt           DateTime

  stripeCustomerId     String?    // This field should probably be on the User or Restaurant model
  stripeSubscriptionId String?    @unique

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([restaurantId])
}

model Payment {
  id                String      @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount            Decimal     @db.Decimal(10, 2)
  currency          String      @default("PLN")
  status            String      // e.g., SUCCEEDED, PENDING, FAILED
  provider          String      // e.g., STRIPE, PAYU (or MOCK for simulation)
  providerPaymentId String?     @unique
  createdAt         DateTime    @default(now())
}

model StandardOffer {
  id           String    @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  price        Float?
  imageUrl     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MenuItem {
  id           String    @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float
  category     String
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
}

model DailyDish {
  id           String      @id @default(uuid())
  restaurantId String

  name         String
  description  String?
  price        Decimal?    @db.Decimal(10, 2)
  imageUrl     String?
  sourceUrl    String?
  sourcePostId String?

  isPromoted   Boolean     @default(false)

  date         DateTime
  publishedAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date], name: "restaurantId_date")
  @@index([date])
  @@index([restaurantId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // "USER", "OWNER" or "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites   FavoriteRestaurant[]
  restaurants Restaurant[]
}

model FavoriteRestaurant {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

model SystemStats {
  id    String @id @default("global")
  views Int    @default(0)
}
