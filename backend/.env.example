# Serwer port dla backendu
PORT=3000

# Adres URL bazy danych PostgreSQL (np. z Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daily_dish?schema=public

# URL Redis dla kolejki BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# URL mikroserwisu scrapper (Playwright)
SCRAPPER_URL=http://localhost:3001

# Konfiguracja wysyłki alertów pocztowych (Nodemailer/Gmail)
GMAIL_USER=app.bistromapa@gmail.com
GMAIL_PASS=your_gmail_app_password
